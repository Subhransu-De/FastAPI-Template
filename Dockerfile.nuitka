FROM ghcr.io/astral-sh/uv:0.11.32 AS uv

# Nuitka 4.1.3 standalone binaries fail during interpreter initialization on
# Python 3.13.14, so keep builder and runtime on the verified patch release.
FROM python:3.13.13-slim AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-recommends -y build-essential ccache patchelf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --python /usr/local/bin/python --frozen --no-build --no-install-workspace --no-dev

# Nuitka is source-only on PyPI, so this pinned compiler is the sole build-script exception.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --python /usr/local/bin/python --frozen --no-install-workspace --no-dev --group compile # NOSONAR

COPY app /app/app

RUN --mount=type=cache,target=/root/.cache/ccache \
    .venv/bin/python -m nuitka \
    --mode=standalone \
    --output-dir=/build \
    --output-filename=fastapi-template \
    --include-package=app \
    --include-package=importlib_metadata \
    --include-module=io \
    --nofollow-import-to=pygments.lexers.* \
    --noinclude-default-mode=nofollow \
    app/main.py

# CPython initializes io before Nuitka's standalone importer is installed.
# Keep the source bootstrap beside the binary until Nuitka embeds it reliably.
RUN cp /usr/local/lib/python3.13/io.py /build/main.dist/io.py

FROM python:3.13.13-slim

LABEL org.opencontainers.image.title="FastAPI Template (Nuitka)"
LABEL org.opencontainers.image.description="Nuitka-compiled FastAPI template"
LABEL org.opencontainers.image.vendor="Subhransu-De"
LABEL org.opencontainers.image.source="https://github.com/Subhransu-De/fastapi-template"
LABEL org.opencontainers.image.base.name="python:3.13.13-slim"

WORKDIR /app

# Refresh the pinned base image's OpenSSL packages to the current Debian fix.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-recommends -y libssl3t64 openssl openssl-provider-legacy \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app

COPY --from=builder --chown=app:app /build/main.dist/ /app/

ENV APP_HOST="0.0.0.0"
ENV PYTHONUNBUFFERED=1

EXPOSE 80

USER app

CMD ["/app/fastapi-template"]
