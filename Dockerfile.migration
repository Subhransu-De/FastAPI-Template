FROM ghcr.io/astral-sh/uv:0.9.30-python3.13-bookworm-slim AS builder

ARG ALEMBIC_VERSION=1.18.5
ARG PSYCOPG_VERSION=3.3.4

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --python /usr/local/bin/python /app/.venv && \
    uv pip install --python /app/.venv/bin/python \
    "alembic[tz]==${ALEMBIC_VERSION}" \
    "psycopg[binary]==${PSYCOPG_VERSION}"

FROM python:3.13.14-slim-bookworm

LABEL org.opencontainers.image.title="FastAPI Template Migration"
LABEL org.opencontainers.image.description="Alembic migration image for FastAPI template"
LABEL org.opencontainers.image.vendor="Subhransu-De"
LABEL org.opencontainers.image.source="https://github.com/Subhransu-De/fastapi-template"
LABEL org.opencontainers.image.base.name="python:3.13.14-slim-bookworm"

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app

COPY --from=builder /app/.venv /app/.venv

COPY alembic.ini /app/
COPY alembic /app/alembic

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

USER app

CMD ["alembic", "-c", "alembic.ini", "upgrade", "head"]
